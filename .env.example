# Copia este archivo como .env y pega los datos de tu proyecto de Supabase.
# Los encuentras en: Project Settings → Data API / API Keys.
#
# Solo la clave "anon" (pública). NUNCA pongas aquí la clave service_role:
# todo lo que empieza por VITE_ termina dentro del JavaScript que se descarga
# en el navegador y queda a la vista de cualquiera.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
